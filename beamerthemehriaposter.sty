\def\fileversion{v0.1}
\def\filedate{2026/02/27}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehriaposter}[\filedate \fileversion HRIA Poster Theme]

% <<< options

\RequirePackage{ifthen}
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
    family=hriaposter,
    prefix=hriaposter@
}

% show a debug layout grid
\DeclareBoolOption[false]{showframe}
\DeclareBoolOption[false]{layoutgrid}

\ProcessOptionsBeamer
\DeclareDefaultOption{\PassOptionsToPackage{\CurrentOption}{beamerposter}}
\ProcessKeyvalOptions*

% >>>

% <<< packages

\RequirePackage{ifpdf}

% fancy graphics
\RequirePackage{beamerposter}
\RequirePackage{tikz}

% nicer command definitions
\RequirePackage{xparse}
% used in defining blocks
\RequirePackage{adjustbox}
\RequirePackage{colortbl}

\ifhriaposter@showframe
    \RequirePackage{showframe}
\fi

\ifhriaposter@layoutgrid
    \RequirePackage[
        grid,
        gridunit=cm,
        gridcolor=gray!70,
        subgridcolor=gray!70,
        texcoord]{eso-pic}
\fi

% remove navigation symbols
\beamertemplatenavigationsymbolsempty

% set colors
\usecolortheme{hriaposter}

% >>>

% <<< commands

% left
\ProvideDocumentCommand \footerleft { m } {\def\hriaposter@footerleft{#1}}
\ProvideDocumentCommand \footerweb { m } {\def\hriaposter@footerleft{\href{#1}{#1}}}

% middle
\ProvideDocumentCommand \footermiddle { m } {\def\hriaposter@footermiddle{#1}}
\ProvideDocumentCommand \footerlocation { m } {\def\hriaposter@footermiddle{#1}}

% right
\ProvideDocumentCommand \footerright { m } {\def\hriaposter@footerright{#1}}
\ProvideDocumentCommand \footername { m } {\def\hriaposter@footerright{#1}}
\ProvideDocumentCommand \footeremail { m } {\def\hriaposter@footerright{\href{mailto:#1}{#1}}}

\ProvideDocumentCommand \heading { m } {%
    \par\medskip%
    {\usebeamerfont{heading}\usebeamercolor[fg]{heading}#1}%
    \par\smallskip}

\ProvideDocumentCommand \separatorcolumn {} {\begin{column}{0.025\paperwidth}\end{column}}

\NewDocumentCommand \headerlogoa  { m } {\def\hriaposter@headerlogoa{#1}}
\NewDocumentCommand \headerlogob  { m } {\def\hriaposter@headerlogob{#1}}
\NewDocumentCommand \headerlogoc  { m } {\def\hriaposter@headerlogoc{#1}}
\NewDocumentCommand \headerlogod  { m } {\def\hriaposter@headerlogod{#1}}

% >>>

% <<< assets

\headerlogoa{\includegraphics[width=0.15\paperheight]{assets/logo-eu-ro}}
\headerlogob{\includegraphics[width=0.035\paperheight]{assets/logo-gov-ro}}
\headerlogoc{\includegraphics[width=0.19\paperheight]{assets/logo-hria-ro}}
\headerlogod{\includegraphics[width=0.14\paperheight]{assets/logo-uvt-ro}}


% >>>

% <<< fonts

\ifpdftex
    \RequirePackage[utf8]{inputenc}
    \RequirePackage[T1]{fontenc}
\else
    \RequirePackage{fontspec}
\fi

\renewcommand{\familydefault}{\sfdefault}

\setbeamerfont{headline title}{size=\huge,series=\bfseries}
\setbeamerfont{headline author}{size=\Large}
\setbeamerfont{headline institute}{size=\Large}
\setbeamerfont{footline}{size=\large,series=\bfseries}

\setbeamerfont*{heading}{size=\Large, series=\bfseries}

\setbeamerfont{block text}{size=\Large}
\setbeamerfont{alert text}{size=\large,series=\bfseries}
\setbeamerfont{block title}{size=\huge,series=\bfseries}
\setbeamerfont{block title alerted}{size=\Huge,series=\bfseries}
\setbeamerfont{block title example}{size=\Huge,series=\bfseries}

\setbeamerfont{url text}{size=\normalsize,series=\bfseries}
\setbeamerfont{author in head/foot}{size=\normalsize,series=\bfseries}

\setbeamerfont{enumerate item}{size={},series=\bfseries}
\setbeamerfont{description item}{size={},series=\bfseries}

\setbeamerfont{itemize/enumerate body}{size={}}
\setbeamerfont{itemize/enumerate subbody}{size={}}
\setbeamerfont{itemize/enumerate subsubbody}{size={}}

% >>>

% <<< outer: header / footer

% headline
\newlength{\maxtitlepadding}
\setlength{\maxtitlepadding}{0.2\paperwidth}

\setbeamertemplate{headline}{
    \begin{beamercolorbox}{}
    \vskip 1ex
    \centering
    \hspace{3em}
    \hriaposter@headerlogoa \hfill
    \hriaposter@headerlogob \hfill
    \hriaposter@headerlogoc \hfill
    \hriaposter@headerlogod
    \hspace{4em}
    \vskip 3ex
    \end{beamercolorbox}
    \ifbeamercolorempty[bg]{headline rule}{}{
        \begin{beamercolorbox}[wd=\paperwidth,colsep=1ex]{headline rule}
        \end{beamercolorbox}
    }
    \begin{beamercolorbox}{headline}
    \begin{columns}
    \begin{column}{\maxtitlepadding}
    \end{column}
    \begin{column}{\dimexpr\paperwidth-\maxtitlepadding-\maxtitlepadding}
        \usebeamerfont{headline}
        \vskip 3ex
        \centering
        {
            \usebeamerfont{headline title}
            \usebeamercolor[fg]{headline title}
            \inserttitle
        }
        \vspace{1em}

        {
            \usebeamerfont{headline author}
            \usebeamercolor[fg]{headline author}
            \insertauthor
        }
        \vspace{1em}

        {
            \usebeamerfont{headline institute}
            \usebeamercolor[fg]{headline institute}
            \insertinstitute
        }
        \vspace{1em}
    \end{column}
    \begin{column}{\maxtitlepadding}
    \end{column}
    \end{columns}
    \vspace{5ex}
    \ifbeamercolorempty[bg]{headline rule}{}{
        \begin{beamercolorbox}[wd=\paperwidth,colsep=1ex]{headline rule}
        \end{beamercolorbox}
    }
    \end{beamercolorbox}
}

% footline

\setbeamertemplate{footline}{
    \begin{beamercolorbox}[vmode]{headline}
        \ifbeamercolorempty[bg]{headline rule}{}{
            \begin{beamercolorbox}[wd=\paperwidth,colsep=0.5ex]{headline rule}
            \end{beamercolorbox}}
        \usebeamerfont{footline}
        \centering
        \vspace{1.25ex}
        \hspace{0.025\paperwidth}
        \@ifundefined{hriaposter@footerleft}{}{\hriaposter@footerleft}
        \hfill
        \@ifundefined{hriaposter@footermiddle}{}{\hriaposter@footermiddle}
        \hfill
        \@ifundefined{hriaposter@footerright}{}{\hriaposter@footerright}
        \hspace{0.025\paperwidth}
        \vspace{1.75ex}
    \end{beamercolorbox}
}

% >>>

% <<< inner

% <<< itemize

\setbeamertemplate{itemize item}{
\tikz[baseline=-0.5em]{
    % circle
    \node[
      circle,
      fill=HRIAGreen,
      minimum size=1.5em,
      inner sep=0pt
    ] (c) {};

    % compute radius
    \pgfmathsetmacro{\r}{0.075}

    % draw thick >
    \draw[
      white,
      line width=0.25em,
      line cap=round,
      line join=round
    ] (-\r, \r) -- (\r, 0) -- (-\r, -\r);
  }%
}

\setbeamertemplate{itemize subitem}{\raisebox{0.4ex}{\color{HRIALightBlue}\Large$\bullet$}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.4ex}{\color{HRIALightBlue}$\blacktriangleright$}}

% >>>

% <<< blocks

\setbeamertemplate{block begin}{
    \begin{adjustbox}{max width=0.98\textwidth}
    \begin{tabular}{!{\color{HRIALightBlue}{\vrule width 10pt}}>{\columncolor[gray]{0.97}}m{\textwidth}}
        \centering
        \begin{minipage}{0.96\linewidth}
        \begin{beamercolorbox}{block title}
            \usebeamerfont*{block title}
            \vbox{}\vskip 0.2ex
            \insertblocktitle
        \end{beamercolorbox}
        \vspace{1em}
        \usebeamerfont*{block text}
}
\setbeamertemplate{block end}{\end{minipage}\vspace{1em}\end{tabular}\end{adjustbox}\vspace*{3ex}}

% >>>

% <<< figures

% disable "Figure:" in the captions
\setbeamertemplate{caption}{\scriptsize\insertcaption}
\setbeamertemplate{caption label separator}{}

% >>>

\setbeamersize{
    description width=0.075\paperwidth,
}

\setbeamertemplate{bibliography item}[text]

% >>>

