\def\fileversion{v0.1}
\def\filedate{2026/02/27}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemehriaposter}[\filedate \fileversion HRIA Poster Color Theme]

% <<< colors

\definecolor{HRIADarkBlue}{RGB}{7, 90, 155}
\definecolor{HRIALightBlue}{RGB}{15, 157, 217}
\definecolor{HRIAGreen}{RGB}{107, 195, 146}

\definecolor{HRIAPurple}{RGB}{115, 44, 144}
\definecolor{HRIABeamerGray}{RGB}{246, 246, 246}

% >>>

% <<< styles

\setbeamercolor{title}{fg=white, bg= , parent=normal text}
\setbeamercolor{titlelike}{fg= , bg= , parent=normal text}
\setbeamercolor{author}{use=normal text, bg= , parent=normal text}
\setbeamercolor{date}{use=normal text, bg= , parent=normal text}
\setbeamercolor{institute}{use=normal text, parent=normal text}

\setbeamercolor{section title}{fg=white, use=title}
\setbeamercolor{frametitle}{fg=HRIADarkBlue, use=titlelike}

\setbeamercolor{headline}{fg=white,bg=HRIADarkBlue}
\setbeamercolor{headline rule}{bg=HRIALightBlue}

\setbeamercolor{url text}{fg=HRIADarkBlue}

\setbeamercolor{block title}{fg=HRIADarkBlue}
\setbeamercolor{alerted text}{fg=HRIADarkBlue}
\setbeamercolor{example text}{fg=HRIALightBlue}

\setbeamercolor{enumerate item}{fg=HRIALightBlue, parent=normal text}
\setbeamercolor{description item}{fg=HRIALightBlue, parent=normal text}

\setbeamercolor{caption}{fg=HRIABeamerGray!50!black, parent=normal text}

